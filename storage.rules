rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function admin() { return request.auth != null && request.auth.token.email_verified == true && request.auth.token.firebase.sign_in_provider == 'google.com' && request.auth.token.email == 'kth9302@gmail.com'; }
  match /materials/{resourceId}/{filename} {
   allow read: if true;
   allow create,update: if admin() && request.resource.size <= 50*1024*1024 && filename.matches('.*\\.(hwp|hwpx|ppt|pptx|pdf|doc|docx|xls|xlsx|zip|png|jpg|jpeg|webp|HWP|HWPX|PPT|PPTX|PDF|DOC|DOCX|XLS|XLSX|ZIP|PNG|JPG|JPEG|WEBP)$');
   allow delete: if admin();
  }
 }
}
